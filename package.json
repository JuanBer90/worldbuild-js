{
  "name": "worldbuild-js",
  "version": "0.0.0",
  "description": "A configurable 3D animation engine for constructing the world from particles",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/worldbuild-js.js"
    }
  },
  "module": "./dist/worldbuild-js.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:data": "tsx scripts/generate-world-points.ts"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "tsx": "^4.21.0"
  }
}
